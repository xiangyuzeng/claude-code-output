        {
          "datasource": { "type": "mysql", "uid": "LJ7ObqYNk" },
          "editorMode": "code",
          "format": "table",
          "rawQuery": true,
          "rawSql": "SELECT\n  r.instance_id,\n  r.instance_class,\n  r.allocated_storage as allocated_gb,\n  ROUND(r.allocated_storage - r.free_storage_space, 2) as used_gb,\n  ROUND(r.free_storage_space, 2) as free_gb,\n  ROUND((r.allocated_storage - r.free_storage_space) / r.allocated_storage * 100, 2) as used_percent,\n  r.max_allocated_storage as max_gb,\n  CASE \n    WHEN r.max_allocated_storage > 0 THEN r.max_allocated_storage - r.allocated_storage\n    ELSE 0\n  END as can_expand_gb,\n  CASE \n    WHEN (r.allocated_storage - r.free_storage_space) / r.allocated_storage >= 0.85 THEN 'CRITICAL'\n    WHEN (r.allocated_storage - r.free_storage_space) / r.allocated_storage >= 0.70 THEN 'WARNING'\n    ELSE 'OK'\n  END as alert_level\nFROM luckyus_db_collection.t_dba_collect_rds_instances r\nINNER JOIN (\n  SELECT instance_id, MAX(data_date) as max_date\n  FROM luckyus_db_collection.t_dba_collect_rds_instances\n  GROUP BY instance_id\n) latest ON r.instance_id = latest.instance_id AND r.data_date = latest.max_date\nWHERE r.allocated_storage > 1\nORDER BY used_percent DESC",
          "refId": "A"
        }
      ],
      "title": "RDS存储空间使用情况",
      "type": "table"
