          "rawQuery": true,
          "rawSql": "SELECT\n  d.instance,\n  d.database_name,\n  ROUND(d.data_free / 1024 / 1024 / 1024, 2) as data_free_gb,\n  ROUND(d.data_free / (d.data_length + d.index_length + d.data_free) * 100, 2) as fragmentation_percent,\n  ROUND((d.data_length + d.index_length + d.data_free) / 1024 / 1024 / 1024, 2) as total_size_gb\nFROM luckyus_db_collection.t_dba_collect_database_info d\nINNER JOIN (\n  SELECT instance, database_name, MAX(data_date) as max_date\n  FROM luckyus_db_collection.t_dba_collect_database_info\n  GROUP BY instance, database_name\n) latest ON d.instance = latest.instance \n  AND d.database_name = latest.database_name \n  AND d.data_date = latest.max_date\nWHERE d.data_free > 100 * 1024 * 1024\nORDER BY d.data_free DESC\nLIMIT 20",
